PORT=8000
# Use "development" only locally (allows the auth cookie over plain http)
NODE_ENV=
# Long random string (32+ chars), e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=7d
# Number of reverse proxies in front of the app (needed for correct rate limiting behind a proxy/CDN)
TRUST_PROXY=
DB_URL=

# Comma separated frontend origins allowed to send cookie-authenticated state-changing requests (optional)
ALLOWED_ORIGINS=
