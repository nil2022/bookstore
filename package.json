{
  "name": "bookstore-api",
  "version": "1.0.1",
  "description": "Bookstore api to manage books and user authentication for your online bookstore. Below, you'll find information on the API endpoints, how to set up and run the application locally, and some of the decisions and assumptions made during the development process.",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --watch server.js",
    "start": "node env-file=.env server.js"
  },
  "keywords": [
    "bcrypt",
    "express",
    "dotenv",
    "jsonwebtoken",
    "mongoose",
    "nodemon",
    "validator"
  ],
  "imports": {
    "#configs/*": "./configs/*.config.js",
    "#controllers/*": "./controllers/*.controller.js",
    "#middlewares/*": "./middlewares/*.middleware.js",
    "#models/*": "./models/*.model.js",
    "#routes/*": "./routes/*.routes.js",
    "#helpers/*": "./helpers/*.helper.js",
    "#root/*": "./*.js"
  },
  "author": "Nilanjan Haldar",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "chalk": "^5.6.2",
    "cookie-parser": "^1.4.6",
    "envalid": "^8.1.0",
    "express": "^4.21.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.3",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "serverless-http": "^3.2.0",
    "validator": "^13.12.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.7",
    "prettier": "^3.3.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nil2022/bookstore.git"
  },
  "bugs": {
    "url": "https://github.com/nil2022/bookstore/issues"
  },
  "homepage": "https://github.com/nil2022/bookstore#readme"
}
